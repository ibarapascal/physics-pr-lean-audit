+            vk_percent=4.0, vkr_percent=1.0, pfe_kw=0.0, i0_percent=0.0,
+            vector_group=eat_vg, shift_degree=330.0, vk0_percent=4.0,
+            vkr0_percent=1.0, mag0_percent=100.0, mag0_rx=0.0, si0_hv_partial=0.9,
