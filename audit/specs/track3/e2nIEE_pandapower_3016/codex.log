+        b_hv = create_bus(net, vn_kv=20.0)
+        b_lv = create_bus(net, vn_kv=0.4)
+        create_ext_grid(net, b_hv, s_sc_max_mva=1000.0, s_sc_min_mva=1000.0,
+                        rx_max=0.1, rx_min=0.1, x0x_max=1.0, x0x_min=1.0,
+                        r0x0_max=0.1, r0x0_min=0.1)
