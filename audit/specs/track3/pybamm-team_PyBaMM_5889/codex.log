#
# Interpolating class
#
from __future__ import annotations

import numbers
from collections.abc import Sequence
from typing import Any

import casadi
import numpy as np
import numpy.typing as npt
from scipy import interpolate

import pybamm


def _is_uniform_grid(x: npt.NDArray[np.float64]) -> bool:
    # Try seeing if the grid was computed using np.linspace
    return bool(np.array_equal(x, np.linspace(x[0], x[-1], len(x))))


class Interpolant(pybamm.Function):
    """
    Interpolate data in 1D, 2D, or 3D. Interpolation in 3D requires the input data to be
    on a regular grid (as per scipy.interpolate.RegularGridInterpolator).

    Parameters
    ----------
    x : iterable of :class:`numpy.ndarray`
        The data point coordinates. If 1-D, then this is an array(s) of real values. If,
        2D or 3D interpolation, then this is to ba a tuple of 1D arrays (one for each
        dimension) which together define the coordinates of the points.
    y : :class:`numpy.ndarray`
        The values of the function to interpolate at the data points. In 2D and 3D, this
        should be a matrix of two and three dimensions respectively.
    children : iterable of :class:`pybamm.Symbol`
        Node(s) to use when evaluating the interpolant. Each child corresponds to an
        entry of x
    name : str, optional
        Name of the interpolant. Default is None, in which case the name "interpolating
        function" is given.
    interpolator : str, optional
        Which interpolator to use. Can be "linear", "cubic", or "pchip". Default is
        "linear". For 3D interpolation, only "linear" an "cubic" are currently
        supported.
    extrapolate : bool, optional
        Whether to extrapolate for points that are outside of the parametrisation
        range, or return NaN (following default behaviour from scipy). Default is True.
        Generally, it is best to set this to be False for 3D interpolation due to
        the higher potential for errors in extrapolation.
    """

    __slots__ = (
        "_entries_string",
        "_num_derivatives",
        "dimension",
        "extrapolate",
        "interpolator",
        "x",
        "y",
    )
    # the data arrays are identified through their string form
    _id_excluded_fields = ("x", "y")

    # entries_string is a derived hash cache of x/y, which are emitted by to_json.
    _serialise_derived_params = frozenset({"entries_string"})

    def __init__(
        self,
        x: npt.NDArray[np.float64] | Sequence[npt.NDArray[np.float64]],
        y: npt.NDArray[Any],
        children: Sequence[pybamm.Symbol] | pybamm.Time,
        name: str | None = None,
        interpolator: str | None = "linear",
        extrapolate: bool = True,
        entries_string: str | None = None,
        _num_derivatives: int = 0,
    ):
        # Check interpolator is valid
        if interpolator not in ["linear", "cubic", "pchip"]:
            raise ValueError(f"interpolator '{interpolator}' not recognised")

        # Normalise x to a list of arrays
        if not isinstance(x, tuple | list):
            x = [x]

        # Perform some checks on the data
        ndim = len(x)
        if ndim == 1:
            x1 = x[0]
            if x1.shape[0] != y.shape[0]:
                raise ValueError(
                    "len(x1) should equal y=shape[0], "
                    f"but x1.shape={x1.shape} and y.shape={y.shape}"
                )
            if np.any(x1[:-1] > x1[1:]):
                raise ValueError("x should be monotonically increasing")
        else:
            if y.ndim != ndim:
                raise ValueError(
                    f"y should be {ndim}-dimensional if len(x)={ndim}, "
                    f"but y.ndim={y.ndim}"
                )
            for i, xi in enumerate(x):
                if xi.shape[0] != y.shape[i]:
                    raise ValueError(
                        f"len(x{i + 1}) should equal y.shape[{i}], "
                        f"but x{i + 1}.shape={xi.shape} and y.shape={y.shape}"
                    )
            if interpolator == "pchip":
                raise ValueError(
                    "interpolator should be 'linear' or 'cubic' "
                    f"if x is {ndim}-dimensional"
                )

        # children should be a list not a symbol or a number
        if isinstance(children, pybamm.Symbol | numbers.Number):
            children = [children]
        if len(x) != len(children):
            raise ValueError("len(x) should equal len(children)")
        if ndim == 1 and y.ndim == 2 and children[0].size != 1:
            raise ValueError(
                "child should have size 1 if y is two-dimensional and len(x)==1"
            )

        # Create interpolating function
        self.dimension = ndim
        if ndim == 1:
            x1 = x[0]
            if interpolator == "linear":
                fill_value: float | str = "extrapolate" if extrapolate else np.nan
                interpolating_function = interpolate.interp1d(
                    x1,
                    y,
                    bounds_error=False,
                    fill_value=fill_value,
                    axis=0,
                )
            elif interpolator == "cubic":
                interpolating_function = interpolate.CubicSpline(
                    x1, y, extrapolate=extrapolate
                )
            elif interpolator == "pchip":
                interpolating_function = interpolate.PchipInterpolator(
                    x1, y, extrapolate=extrapolate
                )
        else:
            fill_value = None if extrapolate else np.nan
            interpolating_function = interpolate.RegularGridInterpolator(
                tuple(x),
                y,
                method=interpolator,
                bounds_error=False,
                fill_value=fill_value,
            )

        # Set name
        if name is None:
            name = "interpolating_function"
        self.x = x
        self.y = y
        self._entries_string = self._make_entries_string(entries_string)

        # Differentiate the interpolating function if necessary
        self._num_derivatives = _num_derivatives
        for _ in range(_num_derivatives):
            interpolating_function = interpolating_function.derivative()

        super().__init__(interpolating_function, *children, name=name)

        # Store information as attributes
        self.interpolator = interpolator
        self.extrapolate = extrapolate

    @classmethod
    def _from_json(cls, snippet: dict):
        """Create an Interpolant object from JSON data"""

        x1 = []

        if len(snippet["x"]) == 1:
            x1 = [np.array(x) for x in snippet["x"]]

        return cls(
            x1 if x1 else tuple(np.array(x) for x in snippet["x"]),
            np.array(snippet["y"]),
            snippet["children"],
            name=snippet["name"],
            interpolator=snippet["interpolator"],
            # the legacy compact format omits these two; default like its decoder did
            extrapolate=snippet.get("extrapolate", True),
            _num_derivatives=snippet.get("_num_derivatives", 0),
        )

    @property
    def entries_string(self):
        return self._entries_string

    @entries_string.setter
    def entries_string(self, value):
        pybamm.expression_tree.symbol._warn_mutation(
            "entries_string", "Construct a new Interpolant with the desired data."
        )
        object.__setattr__(self, "_entries_string", self._make_entries_string(value))

    def _make_entries_string(self, value: str | None) -> str:
        """The hashable form of the data: ``value`` if given, else computed."""
        # We must include the data in the hash, since different interpolants can be
        # indistinguishable by class, name and domain alone
        if value is not None:
            return value
        entries_string = ""
        for i, x in enumerate(self.x):
            entries_string += "x" + str(i) + "_" + str(x.tobytes())
        return entries_string + "y_" + str(self.y.tobytes())

    def create_copy(self, new_children=None, perform_simplifications=True):
        """See :meth:`pybamm.Symbol.new_copy()`."""
        children = self._children_for_copying(new_children)

        return pybamm.Interpolant(
            self.x,
            self.y,
            children,
            name=self.name,
            interpolator=self.interpolator,
            extrapolate=self.extrapolate,
            entries_string=self.entries_string,
            _num_derivatives=self._num_derivatives,
        )

    def _function_evaluate(self, evaluated_children):
        children_eval_flat = []
        for child in evaluated_children:
            if isinstance(child, np.ndarray):
                children_eval_flat.append(child.flatten())
            else:
                children_eval_flat.append(child)
        if self.dimension == 1:
            return self.function(*children_eval_flat).flatten()[:, np.newaxis]
        else:
            shapes = set()
            for child in evaluated_children:
                if isinstance(child, float | int):
                    continue
                shapes.add(child.shape)

            if len(shapes) > 1:
                raise ValueError(
                    "All children must have the same shape for N-D interpolation"
                )

            shape = shapes.pop() if shapes else (1,)
            new_evaluated_children = []
            for child in evaluated_children:
                if hasattr(child, "shape") and child.shape == shape:
                    new_evaluated_children.append(child.flatten())
                else:
                    new_evaluated_children.append(np.reshape(child, shape).flatten())

            nans = np.isnan(new_evaluated_children)
            if np.any(nans):
                nan_children = []
                for child, interp_range in zip(
                    new_evaluated_children, self.function.grid, strict=True
                ):
                    nan_children.append(np.ones_like(child) * interp_range.mean())
                nan_eval = self.function(np.transpose(nan_children))
                return np.reshape(nan_eval, shape)
            else:
                res = self.function(np.transpose(new_evaluated_children))
                return np.reshape(res, shape)

    def _to_casadi(self, t, y, y_dot, inputs, casadi_symbols):
        """See :meth:`pybamm.Symbol._to_casadi()`."""
        converted_children = super()._children_to_casadi(
            t, y, y_dot, inputs, casadi_symbols
        )

        if self.interpolator == "linear":
            return self._linear_to_casadi(converted_children)
        elif self.interpolator == "pchip":
            return self._pchip_to_casadi(converted_children)
        elif self.interpolator == "cubic":
            return self._cubic_to_casadi(converted_children)
        else:
            raise NotImplementedError(  # pragma: no cover
                f"Unknown interpolator: {self.interpolator}"
            )

    def _linear_to_casadi(self, converted_children):
        if self.dimension == 1:
            v = self.y.flatten()
        else:
            v = self.y.ravel(order="F")
        lookup_modes = ["exact" if _is_uniform_grid(xi) else "binary" for xi in self.x]
        result = casadi.MX.interpn_linear(
            self.x, v, converted_children, {"lookup_mode": lookup_modes}
        )
        if result.shape[0] == 1 and result.shape[1] > 1:
            result = result.T
        return result

    def _cubic_to_casadi(self, converted_children):
        if self.dimension == 1:
            # A cubic differentiated three or more times gives a degree-0
            # (piecewise-constant) spline, which CasADi mis-evaluates at the
            # knots (returns 0), so refuse rather than return wrong values (#5582).
            if self._num_derivatives >= 3:
                raise NotImplementedError(
                    "CasADi cannot evaluate the degree-0 spline produced by "
                    "differentiating a 'cubic' interpolant three or more times."
                )
            bspline = interpolate.make_interp_spline(self.x[0], self.y, k=3)
            # Differentiate the spline to match scipy's evaluate (#5582)
            for _ in range(self._num_derivatives):
                bspline = bspline.derivative()
            c_flat = bspline.c.flatten()
            n_basis = len(bspline.t) - bspline.k - 1
            m = c_flat.size // n_basis
            f = casadi.Function.bspline(
                self.name, [bspline.t], c_flat.tolist(), [bspline.k], m
            )
            return f(converted_children[0])
        elif self.dimension == 2:
            bspline = interpolate.RectBivariateSpline(self.x[0], self.x[1], self.y)
            [tx, ty, c] = bspline.tck
            [kx, ky] = bspline.degrees
            f = casadi.Function.bspline(self.name, [tx, ty], c.tolist(), [kx, ky], 1)
            return f(casadi.hcat(converted_children).T).T
        else:
            LUT = casadi.interpolant("LUT", "bspline", self.x, self.y.ravel(order="F"))
            return LUT(casadi.hcat(converted_children).T).T

    def _pchip_to_casadi(self, converted_children):
        x_np = np.asarray(self.x[0], dtype=np.float64)
        y_np = np.asarray(self.y, dtype=np.float64)
        d_np = interpolate.PchipInterpolator(x_np, y_np).derivative()(x_np)

        n = len(x_np) - 1
        h = np.diff(x_np)
        uniform = _is_uniform_grid(x_np)
        is_vector_valued = y_np.ndim > 1
        y_2d = y_np if is_vector_valued else y_np[:, np.newaxis]
        d_2d = d_np if d_np.ndim > 1 else d_np[:, np.newaxis]
        m = y_2d.shape[1]

        # Precompute Hermite cubic coefficients per interval, pre-divided by h^k.
        # p(dx) = c0 + c1*dx + c2*dx² + c3*dx³,  dx = x - x_lo
        # For non-uniform grids x_lo is stored as a 5th table entry;
        # for uniform grids x_lo is computed from the index via scalar arithmetic.
        stride = 4
        if not uniform:
            stride += 1
        coeffs = np.empty((n, stride, m))

        y0 = y_2d[:-1]  # (n, m)
        y1 = y_2d[1:]
        inv_h = (1.0 / h)[:, np.newaxis]  # (n, 1) for broadcasting
        hd0 = h[:, np.newaxis] * d_2d[:-1]
        hd1 = h[:, np.newaxis] * d_2d[1:]

        coeffs[:, 0] = y0
        coeffs[:, 1] = hd0 * inv_h
        coeffs[:, 2] = (-3 * y0 - 2 * hd0 + 3 * y1 - hd1) * inv_h**2
        coeffs[:, 3] = (2 * y0 + hd0 - 2 * y1 + hd1) * inv_h**3
        if not uniform:
            coeffs[:, 4, :] = x_np[:-1, np.newaxis]

        # Honour _num_derivatives (#5582): since dx = x - x_lo, d/dx == d/d(dx),
        # so differentiating just shifts/scales the coeffs (x_lo row untouched).
        # Each row reads the next one up, so this is safe to do in place.
        for _ in range(self._num_derivatives):
            coeffs[:, 0, :] = coeffs[:, 1, :]
            coeffs[:, 1, :] = 2 * coeffs[:, 2, :]
            coeffs[:, 2, :] = 3 * coeffs[:, 3, :]
            coeffs[:, 3, :] = 0.0

        coeffs_flat = casadi.MX(coeffs.reshape(n * stride, m))

        # 1. Single interval index lookup (clamp handles extrapolation)
        x = converted_children[0]
        lookup_mode = "exact" if uniform else "binary"
        idx = casadi.low(casadi.MX(x_np), x, {"lookup_mode": lookup_mode})
        idx = casadi.fmin(casadi.fmax(idx, 0), n - 1)
        base = idx * stride

        # 2. Compute dx = x - x_lo
        if uniform:
            dx = x - (x_np[0] + idx * h[0])
        else:
            dx = x - coeffs_flat[base + 4, 0]

        # 3. Coefficient lookup and Horner evaluation
        c0 = coeffs_flat[base, :]
        c1 = coeffs_flat[base + 1, :]
        c2 = coeffs_flat[base + 2, :]
        c3 = coeffs_flat[base + 3, :]
        result = c0 + (c1 + (c2 + c3 * dx) * dx) * dx

        if is_vector_valued:
            result = result.T
        return result

    def _function_diff(self, children: Sequence[pybamm.Symbol], idx: float):
        """
        Derivative with respect to child number 'idx'.
        See :meth:`pybamm.Symbol._diff()`.
        """
        if len(children) > 1:
            raise NotImplementedError(
                "differentiation not implemented for functions with more than one child"
            )
        else:
            # keep using "derivative" as derivative
            return Interpolant(
                self.x,
                self.y,
                children,
                name=self.name,
                interpolator=self.interpolator,
                extrapolate=self.extrapolate,
                _num_derivatives=self._num_derivatives + 1,
            )

    def to_json(self):
        """
        Method to serialise an Interpolant object into JSON.
        """

        json_dict = {
            "name": self.name,
            "x": [x_item.tolist() for x_item in self.x],
            "y": self.y.tolist(),
            "interpolator": self.interpolator,
            "extrapolate": self.extrapolate,
            "_num_derivatives": self._num_derivatives,
        }

        return json_dict

codex
已核对合并提交中的参数函数、原始扩散系数表和测试：表格横轴确实是正极固相浓度，插值方式为分段线性。规格将重点检查浓度换算、对初始电解液浓度的独立性，以及表格范围内的正扩散系数；PR 报告的放电容量不作为严格不变量。
exec
/bin/zsh -lc "cat > spec.md <<'EOF'
## pybamm-team/PyBaMM#5889 fix: look up Chayambuka2022 NVPF diffusivity at the solid concentration

- What changed (1–3 sentences, naming files and formulas):
  "'`packages/pybamm/src/pybamm/input/parameters/sodium_ion/Chayambuka2022.py` 的 `NVPF_diffusivity_Chayambuka2022(sto, T)` 将查表坐标从 `sto * Initial concentration in electrolyte` 改为 `sto * Maximum concentration in positive electrode`，即由 θ cₑ,₀ 改为固相浓度 cₛ = θ C。默认 C = 15320 mol m⁻³，而 cₑ,₀ = 1000 mol m⁻³；`test_Chayambuka2022.py` 同时增加正极扩散系数回归点、改用相对容差并修正其他期望值，另更新 CHANGELOG 和 sodium-ion 示例 notebook 输出。电解液扩散系数期望值的修正不对应新的电解液物理实现。

- Invariants (mathematical statements; write them as checkable equalities/inequalities, give variables, sign conventions, domain of validity):
  令 θ 为无量纲正极粒子钠占位率，C > 0 为正极最大固相浓度，cₛ = θ C，e = cₑ,₀ 为初始电解液浓度，T₀ = 298.15 K。令合并提交 `data/D_p.csv` 的有序数据为 (xᵢ, dᵢ)，x 的单位为 mol m⁻³，d 的单位为 m² s⁻¹；定义 L(c) 为这张表的分段线性插值。用 D(θ,T;C,e) 表示经过参数处理的公开正极扩散系数函数输出。

  1. **Primary — 固相浓度坐标与表格一致。** 对 xᵢ ≤ θ C ≤ xᵢ₊₁，令 λ = (θ C − xᵢ)/(xᵢ₊₁ − xᵢ)，应有
     D(θ,T₀;C,e) = L(θ C) = (1−λ)dᵢ + λdᵢ₊₁。
     特别地 D(xᵢ/C,T₀;C,e) = dᵢ。归一化变换还应满足 D(c/C₁,T₀;C₁,e) = D(c/C₂,T₀;C₂,e)，前提是保持同一张浓度表且两个占位率均在 [0,1] 内。这是对参数坐标语义的检查，并非宣称不同材料具有同一扩散曲线。
  2. **Secondary — 固相材料扩散系数不依赖无关的电解液初始条件。** 固定 θ、C、T₀ 和数据表，对任意测试域内 e₁,e₂，应有 D(θ,T₀;C,e₁) = D(θ,T₀;C,e₂)。该条件仅针对这个局部本构函数；改变 e 可以通过电解液传输和反应动力学改变整个电池的轨迹，故不要求电压或容量保持不变。
  3. **Secondary — 表内正扩散与局部包络。** 对上述每个区间，0 < min(dᵢ,dᵢ₊₁) ≤ D ≤ max(dᵢ,dᵢ₊₁)。整张表内进一步有 1.95×10⁻¹⁷ ≤ D ≤ 2.51×10⁻¹⁵ m² s⁻¹。采用朝浓度增加方向为正的浓度梯度 g = ∇cₛ，以及 Fick 通量 J = −Dg，则 J·g = −D‖g‖² ≤ 0，g ≠ 0 时严格小于零。这个局部耗散符号不等式不等同于对整套 DFN 离散系统的稳定性或能量守恒证明。数据本身非单调，不应要求 D 随 θ 全局单调。

- Sources of the invariants (first principles / literature formula / consistency with other implementations in the library / dimensions):
  主要证据是合并提交的 [Chayambuka2022 参数源码](https://github.com/pybamm-team/PyBaMM/blob/eda03ed6d1003b186cc2d70ad8b3240a7b6350f1/packages/pybamm/src/pybamm/input/parameters/sodium_ion/Chayambuka2022.py) 和 [D_p.csv 原始表及单位表头](https://github.com/pybamm-team/PyBaMM/blob/eda03ed6d1003b186cc2d70ad8b3240a7b6350f1/packages/pybamm/src/pybamm/input/parameters/sodium_ion/data/D_p.csv)。占位率定义 θ = cₛ/C 给出第一条；同文件的负极 `HC_diffusivity_Chayambuka2022` 也以 θ 乘该电极最大浓度。仅凭量纲不能识别原错误，因为 e 与 C 的量纲相同，必须区分固相与电解液的物理身份。
  [Interpolant 源码](https://github.com/pybamm-team/PyBaMM/blob/eda03ed6d1003b186cc2d70ad8b3240a7b6350f1/packages/pybamm/src/pybamm/expression_tree/interpolant.py) 确认默认一维插值为 linear；因此凸组合公式和包络属于这个库的本构表示约定。第二条来自该参数模型将固相扩散表示为固相浓度函数的假设；第三条的通量符号来自 Fick 定律和正扩散要求。源码引用 K. Chayambuka et al., “Physics-based modeling of sodium-ion batteries part II. Model and validation”, Electrochimica Acta 404 (2022), 139764，DOI 10.1016/j.electacta.2021.139764，并注明参数来自 COMSOL 示例；本审计未独立读取论文或 COMSOL，故不将表格与原始实验的准确性视为已验证，也不推断额外温度依赖。

- Common operating domain (range of each input, with the basis):
  核心物理域固定 C = 15320 mol m⁻³，T = 298.15 K，e = 1000 mol m⁻³，依据该参数集默认值。只在已提供数据的 cₛ ∈ [131.578947, 15197.36842] mol m⁻³ 上主张表格精度，即 θ ∈ [131.578947/15320, 15197.36842/15320]，约 [0.0085887, 0.991995]。不把整个 [0,1] 的端部外推视为已验证物理域：该 Interpolant 默认允许外推，但缺少表外数据支撑。
  对第二条，用 e ∈ [500,1500] mol m⁻³ 作围绕默认值的有限扰动域；这是用于识别错误耦合的测试选择，不是文献验证的电池运行浓度范围。对第一条的坐标变换，用 C₁,C₂ ∈ [15320,18384] mol m⁻³（默认值的 1–1.2 倍），保持 cₛ 在原表内，再取 θⱼ = cₛ/Cⱼ；这一域保证 θⱼ ∈ (0,1)，仅用于代数一致性测试。若做通量符号检查，可选 g = (10⁶ mol m⁻⁴)u，u ∈ [−1,1]³，包含零与混合符号方向；幅度只是避免浮点极端值的测试尺度，不是额外的材料适用范围。T 参数虽被函数接受，但当前函数未使用它；不将真实材料的温度不变性列为物理不变量。

- Numerical check method (which public API of the merged commit, what to compute, what to compare against, suggested tolerance and why; if finite differences are needed, the step-size strategy):
  下面是后续执行方案，本次没有安装、导入或运行 PyBaMM，也没有数值验证结果。
  使用 `p = pybamm.ParameterValues("Chayambuka2022")`，按需要用 `p.update({...})` 设置完整名称 `"Maximum concentration in positive electrode [mol.m-3]"` 与 `"Initial concentration in electrolyte [mol.m-3]"`。构造 `expr = p["Positive particle diffusivity [m2.s-1]"](pybamm.Scalar(theta), pybamm.Scalar(298.15))`，通过 `p.evaluate(expr)` 取得数值（若返回单元素数组，提取该元素）。每组 C、e 使用新的 ParameterValues 和表达式，以免缓存或前次处理污染检查。
  独立读取固定合并提交的 CSV 两列，不从被测表达式的 children 或内部 x/y 反推出期望值，也不再调用 `pybamm.Interpolant` 作为 oracle。先确认 x 严格递增且 d > 0，再用上面的两点凸组合直接计算 L。
  第一条检查全部 34 个节点及 33 个区间中点，并对每个区间采样若干 λ ∈ (0,1)，令 θ = ((1−λ)xᵢ+λxᵢ₊₁)/C。覆盖端点和局部极值附近，并进行上述不同 C、相同 cₛ 的成对比较。建议对未舍入 CSV oracle 使用 `abs(D−L)/abs(L) ≤ 1e−10`，绝对容差为零；这是同一十进制表的双精度算术一致性检查，容差给浮点坐标换算和区间定位留余量，不代表实验精度。
  第二条对相同 θ、C 取 e = 500、1000、1500 及区间内随机值，两两比较相对误差 ≤ 1e−12，绝对容差为零。原实现会依赖 e，故该检验能区别浓度身份错误；正确表达式不引用 e，预期差异为零。
  第三条复用所有采样，先要求有限且 D > 0，再检查局部上下界，边界允许 `1e−10 * max(dᵢ,dᵢ₊₁)` 的浮点余量。用 API 返回的 D 和选定 g 构造 J，检查 J·g ≤ 0；该步骤只核查本构后果，不声称执行了库内完整通量离散。D 的严格正值检查不能被大绝对容差替代。
  额外的已公布回归点可取 θ = 0.3、0.5、0.9，对应约 5.6673e−17、8.3317e−17、3.5627e−17 m² s⁻¹；这些舍入值采用 1e−4 相对容差即可。无需有限差分：直接代入查表公式和参数成对测试足够，且分段线性插值在节点一般不可微。PR 描述的 1C/2C 截止容量仅是多因素模拟结果，不作为这里的硬性 oracle。

- Do the PR'"'s own tests already check this invariant (yes/partial/no, naming test files and assertions):
